# 复制成 .env 后填写：cp .env.example .env
# .env 只留在本机（已在 .gitignore 里），不要把真实 key 写进这个模板或任何会提交的文件。
# 终端里已经 export 的同名变量优先。

# 强模型档（也用作路由标注的裁判），对应 configs/models.yaml 的 api_key_env
BAICHUAN_API_KEY=
DEEPSEEK_API_KEY=

# 本地 vLLM（不校验时随便填）与 DSH → 网关的 key（网关不校验）
VLLM_API_KEY=dummy
MEDAGENT_GATEWAY_KEY=dummy

# 校验链路默认：规则 → Laya 判别模型（:8002，training/verifier/04_serve.sh）→ Skywork 奖励模型（:8003，06_reward.sh），没部署的一步自动跳过
# 想用“规则 → Skywork”（不经过 Laya），取消下面这一行的注释即可：
# MEDAGENT_VERIFIER_URL=
# 奖励模型打分（Skywork-Reward-V2，training/verifier/06_reward.sh）：默认接本机 http://127.0.0.1:8003，没部署时自动跳过；设成空值 = 不用
# MEDAGENT_REWARD_URL=

# 可选
# MEDAGENT_REDIS_URL=redis://127.0.0.1:6379/0
# MEDAGENT_ONLINE_KB=1
# MEDAGENT_STATE_DIR=.medagent_state
